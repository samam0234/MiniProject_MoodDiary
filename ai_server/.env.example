PORT=5000
# ollama (local LLM) | lexicon (keyword dictionary, no extra deps) | transformers
EMOTION_BACKEND=ollama
MAX_TEXT_LENGTH=5000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- ollama backend (requires: ollama serve, ollama pull gemma4:12b) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
# Seconds. The first call loads the model (~15s cold start), so keep this generous.
OLLAMA_TIMEOUT=60
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0.2

# --- transformers backend (only when EMOTION_BACKEND=transformers) ---
EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base
